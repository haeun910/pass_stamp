# 로컬 실행: 이 파일을 .env.local로 복사해서 값을 채워요. Vercel에서는 프로젝트 설정의 Environment Variables에 넣어요.

# Claude API 키 (필수)
ANTHROPIC_API_KEY=

# 로그인 (배포 시 필수). 비워 두면 로컬 개발에서는 로그인 없이 써요. 프로덕션에서 빠지면 AI 기능이 막혀요.
# Postgres 주소 (Vercel 마켓플레이스의 Neon을 연결하면 자동으로 들어가요)
DATABASE_URL=
# 로그인 쿠키 서명용 비밀값. 32자 이상 무작위 값: openssl rand -base64 32
BETTER_AUTH_SECRET=
# 배포 주소 (로컬은 http://localhost:3000)
BETTER_AUTH_URL=
# 관리자 계정. 빌드할 때 이 이메일·비밀번호(12자 이상)로 만들어져요. 가입 신청은 이 계정만 수락할 수 있어요.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 배포 주소 (배포 시 필수). sitemap, robots, 공유 이미지 주소에 들어가요. 예: https://pass-stamp.vercel.app
NEXT_PUBLIC_SITE_URL=

# 선택
# RATE_LIMIT_PER_HOUR=60
# 비워 두면 작업마다 정한 모델을 써요. 넣으면 모든 작업을 그 모델 하나로 고정해요(문제가 생겼을 때 되돌리는 용도).
# CLAUDE_MODEL=claude-opus-5-5
